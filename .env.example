# Порт HTTP-сервера
PORT=3000
# Путь к файлу базы SQLite
DB_PATH=data/kinobuddy.db
# production включает Secure-cookie
NODE_ENV=development
# Заполнить демо-афишей при первом запуске (1 = да)
SEED_DEMO=1
# E-mail, который при регистрации получает роль администратора
ADMIN_EMAIL=
# Ключ TMDB API (https://www.themoviedb.org/settings/api) для описаний и постеров
TMDB_API_KEY=
# Запускать парсеры афиши по расписанию (1 = да)
SCRAPE_ENABLED=0
# Интервал парсинга, часы
SCRAPE_INTERVAL_HOURS=6
# Контакт в User-Agent парсера
SCRAPER_CONTACT=admin@example.com
